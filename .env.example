# Leave unset to run entirely offline on the deterministic stub provider.
# BELLWETHER_PROVIDER: stub | replay | record | anthropic
BELLWETHER_PROVIDER=stub

# Only read when BELLWETHER_PROVIDER is anthropic or record.
# ANTHROPIC_API_KEY=

BELLWETHER_MODEL=claude-opus-5
BELLWETHER_SEED=1729
BELLWETHER_PORT=8788
